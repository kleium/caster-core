# Caster's Tool API — environment configuration
# Copy to .env for local development. On Render, set these as environment
# variables on the service instead (never commit real values).

# ── Required ────────────────────────────────────────────────
# The Blue Alliance API key. The server refuses to start without it.
TBA_API_KEY=

# ── Upstream data sources ───────────────────────────────────
# FIRST FRC/FTC Events API tokens, Base64 of "username:authkey".
FRC_EVENTS_API_TOKEN=
FTC_EVENTS_API_TOKEN=

# ── Supabase ────────────────────────────────────────────────
# SERVICE_KEY bypasses RLS — server-side only, never expose to clients.
# ANON_KEY is used for user-facing auth (password login, passkey session exchange).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Verifies access tokens where a claim becomes stored data (note authorship).
# Without it, notes are saved unattributed rather than trusting the client.
SUPABASE_JWT_SECRET=

# ── AI storylines (optional) ────────────────────────────────
# Without this, /api/storylines/status reports available:false and generation
# returns 503.
ANTHROPIC_API_KEY=

# ── Passkeys / WebAuthn ─────────────────────────────────────
# RP_ID must be the domain the BROWSER runs on (the web app), NOT the API host.
# Changing it invalidates every existing passkey — see the separation plan.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
PASSKEY_RP_NAME=Caster's Tool

# ── Rate limiting ───────────────────────────────────────────
# Comma-separated keys granted raised limits. Note the limiter is in-process and
# keyed by IP, so an event venue behind one NAT shares a single bucket.
TRUSTED_API_KEYS=

# ── Server ──────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Workers ─────────────────────────────────────────────────
# Set to 1 to run read-only with no background ingestion.
# IMPORTANT: exactly ONE process may run workers, and in-process state
# (rate-limit buckets, passkey challenges, poller sets) means this service must
# not be horizontally scaled without moving that state to Redis first.
# DISABLE_WORKERS=1

# Comma-separated event keys to force-watch (testing aid).
# POLL_EVENTS=
# POLL_FTC_EVENTS=

# ── Filesystem (see src/lib/paths.ts) ───────────────────────
# Render's default disk is ephemeral. Point CACHE_DIR at a mounted disk to keep
# the payload cache across deploys; it is only a cache, so losing it costs a
# rebuild on the next request, never correctness.
# CACHE_DIR=/var/data/saved_events
# STATIC_DATA_DIR=

# ── Strangler-migration leftover ────────────────────────────
# Unported routes used to proxy here. The port is complete (83/83 routes), so
# this is unused unless the proxy fallback is deliberately re-enabled.
# FASTAPI_UPSTREAM=http://127.0.0.1:8000
