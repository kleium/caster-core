# ── Secrets — never commit ──────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies / build output ─────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── Runtime payload cache (regenerates on demand; see lib/paths.ts).
# data/static/ IS committed — it holds bundled read-only lookups.
data/saved_events/

# ── Logs / OS noise ─────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
